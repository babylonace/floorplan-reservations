# Copy this file to .env. Never commit .env.

# Used by `npm run dev`, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgres://floorplan:local-only-password@127.0.0.1:5432/floorplan

# Used by `npm test`. The tests WIPE this database, so its name must end in _test.
TEST_DATABASE_URL=postgres://floorplan:local-only-password@127.0.0.1:5432/floorplan_test

# Used by `npm run e2e` (browser tests). They WIPE this database, so its name must end in _e2e.
E2E_DATABASE_URL=postgres://floorplan:local-only-password@127.0.0.1:5432/floorplan_e2e

# The built web app the API serves at /. By default it serves apps/web/dist when that exists.
# WEB_DIR=apps/web/dist

# Docker Compose settings. The password goes inside a URL, so use only letters, digits, - and _.
POSTGRES_PASSWORD=local-only-password
DB_PORT=5432
API_PORT=3000

# Behind a reverse proxy, list its addresses so the API sees each guest's own address.
# Without it every guest shares the proxy's address, and so one booking rate limit.
# TRUST_PROXY=127.0.0.1

# Booking requests one address may send per window (defaults: 10 every 15 minutes).
# BOOKING_RATE_LIMIT_MAX=10
# BOOKING_RATE_LIMIT_WINDOW_MINUTES=15

# Sign-in requests one address may send per window (defaults: 30 every 15 minutes). On top of
# this, one e-mail address is locked for 15 minutes after 10 failed sign-ins.
# LOGIN_RATE_LIMIT_MAX=30
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
