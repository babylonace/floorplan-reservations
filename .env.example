# Copy this file to .env. Never commit .env.

# Used by `npm run dev`, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgres://floorplan:local-only-password@127.0.0.1:5432/floorplan

# Used by `npm test`. The tests WIPE this database, so its name must end in _test.
TEST_DATABASE_URL=postgres://floorplan:local-only-password@127.0.0.1:5432/floorplan_test

# Docker Compose settings. The password goes inside a URL, so use only letters, digits, - and _.
POSTGRES_PASSWORD=local-only-password
DB_PORT=5432
API_PORT=3000
